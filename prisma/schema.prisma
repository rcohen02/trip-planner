// T2T writable state. Trip content (places, flights) is read-only in v1 and lives in content/generated.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SlotAssignment {
  trip      String
  slotId    String
  placeId   String
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@id([trip, slotId])
  @@unique([trip, placeId])
}

model TodoState {
  trip      String
  todoId    String
  done      Boolean
  updatedAt DateTime @updatedAt

  @@id([trip, todoId])
}

model TripShare {
  token     String    @id
  trip      String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([trip])
}

/// A slot added on the Itinerary board (e.g. a second afternoon). Base slots come from trip.json.
model ExtraSlot {
  id        String   @id
  trip      String
  date      String
  after     String
  label     String
  createdAt DateTime @default(now())

  @@index([trip])
}

/// A new name someone gave a base slot (e.g. "Lunch" → "Canalha lunch").
model SlotLabel {
  trip      String
  slotId    String
  label     String
  updatedAt DateTime @updatedAt

  @@id([trip, slotId])
}

/// A reservation for a planned place. Date and time are Lisbon wall-clock (trip time zone).
model Booking {
  trip         String
  placeId      String
  date         String
  time         String
  confirmation String?
  note         String?
  updatedAt    DateTime @updatedAt

  @@id([trip, placeId])
}

/// A place whose hours someone checked (the ✓ on "Hours unconfirmed" in Itinerary).
model HoursCheck {
  trip      String
  placeId   String
  createdAt DateTime @default(now())

  @@id([trip, placeId])
}

/// A walking route uploaded on the Itinerary (from a Google My Maps KMZ/KML). line = [[lat, lng], …].
model Route {
  id         String   @id
  trip       String
  name       String
  line       Json
  startLabel String?
  endLabel   String?
  createdAt  DateTime @default(now())

  @@index([trip])
}

/// A place on the trip's shortlist (the Shortlist toggle that replaced "Want").
model ShortlistItem {
  trip      String
  placeId   String
  createdAt DateTime @default(now())

  @@id([trip, placeId])
}

/// Someone who can sign in (replaces ALLOWED_EMAILS). Emails are lower-case.
model User {
  email     String   @id
  name      String?
  admin     Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// An invitation to join the app; accepted on first sign-in.
model Invite {
  email      String    @id
  invitedBy  String
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
}

/// A whole trip (logistics + places) as one JSON document, the shape of lib/content/types Trip.
/// Phase 1 keeps the document whole so place ids match existing plan rows; places split out in Phase 3.
model Trip {
  slug      String   @id
  data      Json
  startDate String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TripMember {
  slug    String
  email   String
  role    String
  addedAt DateTime @default(now())

  @@id([slug, email])
  @@index([email])
}
