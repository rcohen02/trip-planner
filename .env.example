# Copy to .env.local. Never commit real values.
DATABASE_URL=""            # Neon pooled connection string (Vercel adds this when you connect Neon). Empty = in-memory store for local dev.
AUTH_SECRET=""             # npx auth secret
AUTH_GOOGLE_ID=""          # Google Cloud OAuth client (Web). Leave empty locally to skip sign-in in dev.
AUTH_GOOGLE_SECRET=""
