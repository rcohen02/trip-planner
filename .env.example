# Copy to .env.local. Never commit real values.
DATABASE_URL=""            # Neon pooled connection string (Vercel adds this when you connect Neon). Empty = in-memory store for local dev.
AUTH_SECRET=""             # npx auth secret
AUTH_GOOGLE_ID=""          # Google Cloud OAuth client (Web). Leave empty locally to skip sign-in in dev.
AUTH_GOOGLE_SECRET=""
ALLOWED_EMAILS="you@example.com"
SITE_URL=""                # Production URL, e.g. https://t2t.vercel.app (used in share links)
GOOGLE_PLACES_API_KEY=""     # Google Maps Platform key, Places API (New) only. Server-side; used for business photos.
